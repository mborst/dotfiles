#!/bin/bash

echo "unlinking ideavimrc"
rm -f "${HOME}/.ideavimrc"

echo "unlinking gitconfig"
rm -f "${HOME}/.gitconfig"

rm -f "${HOME}/.zshenv"

rm -f "${DOTFILES}/nvim/pack/submodules/start/fzf"

NVIM_CONFIG_PATH=~/.config/nvim
rm -rf "${NVIM_CONFIG_PATH}"

GHOSTTY_CONFIG_PATH="${HOME}/Library/Application Support/com.mitchellh.ghostty/config"
echo "unlinking ghostty/config"
rm -f "${GHOSTTY_CONFIG_PATH}"
