[core]
  editor = nvim
  excludesfile = ~/.gitignore
  attributesfile = ~/.gitattributes

[color]
  ui = auto

[push]
  default = current

[alias]
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
  d = difftool

[merge]
  tool = vimdiff
  conflictstyle = zdiff3

[mergetool]
  prompt = true

[mergetool "vimdiff"]
  cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[diff]
  tool = vimrdiff
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[difftool]
  prompt = false

[difftool "vimdiff"]
  cmd = nvim -d $LOCAL $REMOTE

[fetch]
  writeCommitGraph = true
  prune = true

[pull]
  rebase = true

[commit]
  gpgsign = false

[interactive]
	singleKey = true

[user]
  name = Michael Borst
